{
	"extension": [
		"ts"
	],
	"spec": [
		"src/**/__tests__/*.ts",
		"src/core/assistant-message/*.test.ts",
		"careti-src/core/task/tools/__tests__/*.ts",
		"careti-src/core/api/**/__tests__/*.ts",
		"careti-src/core/api/providers/__tests__/*.ts",
		"careti-src/core/prompts/__tests__/*.ts",
		"careti-src/core/editing/__tests__/*.ts",
		"careti-src/integrations/document/__tests__/*.ts"
	],
	"require": [
		"ts-node/register",
		"source-map-support/register",
		"./src/test/require-shim.js",
		"./src/test/requires.ts"
	],
	"node-option": [
		"no-experimental-strip-types"
	],
	"recursive": true,
	"exit": true
}
