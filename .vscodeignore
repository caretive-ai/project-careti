# 🚨 WHITELIST APPROACH: exclude everything, then allow only release artifacts
**

# ✅ Core metadata
!package.json
!README.md
!LICENSE
!CHANGELOG.md

# ✅ Built extension code
!dist/
!dist/**
!webview-ui/build/
!webview-ui/build/**

# ✅ Assets / themes
!assets/
!assets/**
!src/integrations/theme/default-themes/
!src/integrations/theme/default-themes/**

# ✅ Caret runtime sources used at runtime
!caret-src/
!caret-src/**

# ❌ Exclude merge/development directories
caret-main/**
caret-compare/**
caret-b2b/**
caret-docs/**
comparison/**
cli/**
cli-caret/**
standalone/**
dist-standalone/**
scripts/**
caret-scripts/**
testing-platform/**
spec-kit/**
output/**
.caretrules/**

# ❌ Exclude source/config/docs we don't ship
src/**
webview-ui/**
docs/**
old_docs/**
docs.caret.team/**
node_modules/**
.vscode/**
.github/**
.husky/**
.changeset/**
.clinerules/**
*.mdx

# ✅ Allow specific dependency assets / runtime shims
!node_modules/@vscode/codicons/dist/codicon.css
!node_modules/@vscode/codicons/dist/codicon.ttf
!standalone/
!standalone/runtime-files/
!standalone/runtime-files/vscode/
!standalone/runtime-files/vscode/enhanced-terminal.js
