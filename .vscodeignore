# Default - Basic VSCode Extension Files
.vscode/**
.vscode-test/**
out/**
dist-standalone/
node_modules/
src/**
standalone/**
.gitignore
.yarnrc
esbuild.js
vsc-extension-quickstart.md
tsconfig*.json
**/.eslintrc.json
**/*.map
**/*.ts
**/.vscode-test.*
eslint-rules/**
.github/**
.husky/**

# Custom Ignored Files
**/demo.gif
.nvmrc
.gitattributes
.prettierignore
.eslintignore
.prettierrc
.husky/
.github/
eslint-rules/
old_docs/
evals/
.changie.yaml
.codespellrc
.mocharc.json
buf.yaml
.changeset/
.clinerules/

# Configuration Files
*.config.ts
*.config.js
*.env*
vitest.config.*

# Specific Project Files
CHANGELOG.md
CONTRIBUTING.md
LICENSE
README.*.md

# Development Scripts
caret-scripts/**
scripts/**

# Dev Directories
eslint-rules/**
webview-ui/tests/**
coverage/**
.changeset/**
__tests__/**
__mocks__/**
.turbo
dist-standalone/**

# Build Files
tsconfig.tsbuildinfo

# 🚨 CRITICAL: Exclude entire caret-zero directory (contains huge node_modules)
caret-zero/**

# 🚨 CRITICAL: Exclude all node_modules except specific whitelisted ones
node_modules/**
webview-ui/node_modules/**

# Ignore documentation files
caret-docs/**
docs/**
evals/**
new-docs/**

# Ignore test templates
caret-assets/test-templates/**

# Ignore backup and build files
**/*.cline
**/*.backup
**/*.bak
**/*.log
**/*.tgz
**/*.zip
*.vsix

# Ignore test and analysis files
test-setup.js
task-log-analysis*.json
test-results.json
tsconfig.test.json
tsconfig.unit-test.json
analyze-existing-task-logs.js
cline-test-*.json
meetup-summary.md
system-prompt-token-measurement.js
*-login.md

# Ignore locales directory (multiple language docs)
locales/**

# Ignore Proto source files
proto/**
!proto/build/**

# Ignore all webview-ui files except the build directory
webview-ui/src/**
webview-ui/public/**
webview-ui/index.html
webview-ui/README.md
webview-ui/package.json
webview-ui/package-lock.json
webview-ui/cypress/**
webview-ui/cypress.*
webview-ui/*.config.*
webview-ui/tsconfig*
webview-ui/.env*
**/.gitignore

# Fix issue where codicons don't get packaged
!node_modules/@vscode/codicons/dist/codicon.css
!node_modules/@vscode/codicons/dist/codicon.ttf

# Include default themes JSON files used in getTheme
!src/integrations/theme/default-themes/**

# Include necessary assets
!assets/icons/**
!caret-assets/icons/**
!caret-assets/template_characters/**
!caret-assets/rules/**

# Include compiled output
!dist/**
!webview-ui/build/**

# Additional directories to ignore
old_docs/**
standalone/**
walkthrough/**
!walkthrough/*.md  # walkthrough에서 필요한 마크다운 파일만 포함

# Ignore E2E build files
e2e-build.js
e2e.vsix
test-results/
