# 🚨 WHITELIST APPROACH: exclude everything, then allow only release artifacts
**

# ✅ Core metadata
!package.json
!README.md
!LICENSE
!CHANGELOG.md

# ✅ Built extension code
!dist/
!dist/**
!webview-ui/build/
!webview-ui/build/**

# ✅ Assets / themes
!assets/
!assets/**
!src/integrations/theme/default-themes/
!src/integrations/theme/default-themes/**

# ✅ Caret runtime sources used at runtime
!careti-src/
!careti-src/**

# ❌ Exclude merge/development directories
careti-main/**
careti-compare/**
careti-b2b/**
careti-docs/**
comparison/**
cli/**
cli-caret/**
standalone/**
dist-standalone/**
scripts/**
careti-scripts/**
testing-platform/**
spec-kit/**
output/**
.caretrules/**

# ❌ Exclude source/config/docs we don't ship
src/**
webview-ui/**
docs/**
old_docs/**
docs.careti.ai/**
node_modules/**
.vscode/**
.github/**
.husky/**
.changeset/**
.clinerules/**
*.mdx

# ✅ Allow specific dependency assets / runtime shims
!node_modules/@vscode/codicons/dist/codicon.css
!node_modules/@vscode/codicons/dist/codicon.ttf

# ✅ HWP parser native modules (external in esbuild, must be included in VSIX)
# Only whitelist necessary files - exclude iOS/Android React Native binaries (125MB)
!node_modules/@napi-rs/wasm-runtime/
!node_modules/@napi-rs/wasm-runtime/**

# Platform-specific native binaries (~1MB each)
!node_modules/@ohah/hwpjs-darwin-arm64/
!node_modules/@ohah/hwpjs-darwin-arm64/**
!node_modules/@ohah/hwpjs-darwin-x64/
!node_modules/@ohah/hwpjs-darwin-x64/**
!node_modules/@ohah/hwpjs-linux-x64-gnu/
!node_modules/@ohah/hwpjs-linux-x64-gnu/**
!node_modules/@ohah/hwpjs-win32-x64-msvc/
!node_modules/@ohah/hwpjs-win32-x64-msvc/**
!node_modules/@ohah/hwpjs-wasm32-wasi/
!node_modules/@ohah/hwpjs-wasm32-wasi/**

# Main hwpjs package - only dist/index.js and package.json
!node_modules/@ohah/hwpjs/package.json
!node_modules/@ohah/hwpjs/dist/index.js
!node_modules/@ohah/hwpjs/dist/index.d.ts
!standalone/
!standalone/runtime-files/
!standalone/runtime-files/vscode/
!standalone/runtime-files/vscode/enhanced-terminal.js
