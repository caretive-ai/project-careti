{
  "description": "브랜딩 처리 대상 파일 정의 - 파일별 처리 방법 관리",
  "version": "2.0.0",
  "last_updated": "2025-08-31",
  
  "file_patterns": [
    {
      "path": "package.json",
      "type": "json",
      "encoding": "utf8", 
      "priority": "critical",
      "backup": true,
      "fields": [
        "displayName",
        "author.name", 
        "keywords[0]",
        "contributes.viewsContainers.activitybar[0].title",
        "contributes.viewsContainers.activitybar[1].title",
        "contributes.commands[*].title",
        "contributes.commands[*].category", 
        "contributes.configuration.title",
        "contributes.walkthroughs[0].title",
        "contributes.walkthroughs[0].description"
      ]
    },
    
    {
      "path": "webview-ui/src/caret/locale/*/common.json",
      "type": "json",
      "encoding": "utf8",
      "priority": "medium", 
      "backup": false,
      "wildcard": true,
      "status": "future_support",
      "fields": [
        "app_name",
        "brand_display_name"
      ]
    },
    
    {
      "path": "webview-ui/src/caret/locale/*/settings.json", 
      "type": "json",
      "encoding": "utf8",
      "priority": "medium",
      "backup": false, 
      "wildcard": true,
      "status": "future_support",
      "fields": [
        "brand_name", 
        "product_name"
      ]
    },
    
    {
      "path": "locales/*/",
      "type": "directory",
      "encoding": "utf8",
      "priority": "low",
      "backup": false,
      "wildcard": true, 
      "status": "future_support",
      "description": "다국어 지원 디렉토리 (향후 확장)"
    }
  ]
}