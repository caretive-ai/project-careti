      "setup": {
        "import": "import { useTranslation } from '@/caret/utils/i18n'",
        "hook": "const { t } = useTranslation()"
      },
      "replacements": [
        {
          "from": "\"Cline wants to execute this command:\"",
          "to": "t('chat.executeCommand')",
          "type": "string"
        },
        {
          "from": "\"Cline is having trouble...\"",
          "to": "t('chat.havingTrouble')",
          "type": "string"
        },
        {
          "from": "\"Cline has a question:\"",
          "to": "t('chat.caretHasQuestion')",
          "type": "string"
        },
        {
          "from": "\"Cline wants to edit this file:\"",
          "to": "t('chat.wantsToEdit')",
          "type": "string"
        },
        {
          "from": "\"Cline wants to create a new file:\"",
          "to": "t('chat.caretWantsToCreateNewFile')",
          "type": "string"
        },
        {
