{
    "metadata": {
      "brand": "cline",
      "target": "caret",
      "description": "Caret ↔  Cline branding conversion"
    },
    "brand_mappings": {
      "package_json": {
        "caret": "claude-dev",
        "Caret": "Cline",
        "CARET": "CLINE",
        "Caretive Inc.": "Cline Bot Inc.",
        "caretive": "saoudrizwan",
        "https://github.com/aicoding-caret/caret": "https://github.com/cline/cline",
        "https://caret.team": "https://cline.bot",
        "An autonomous coding AI agent, forked from Cline. For context-aware pair programming, refactoring, and 'vibe coding' with customizable AI personas. Supports: 한국어, 日본語, 중문.": "Autonomous coding agent right in your IDE, capable of creating/editing files, running commands, using the browser, and more with your permission every step of the way.",
        "Meet Caret, your new coding partner": "Meet Cline, your new coding partner",
        "Let Caret Learn Your Codebase": "Let Cline Learn Your Codebase",
        "Add to Caret": "Add to Cline",
        "Generate Commit Message with Caret": "Generate Commit Message with Cline",
        "Generate Commit Message with Caret - Stop": "Generate Commit Message with Cline - Stop",
        "Explain with Caret": "Explain with Cline",
        "Improve with Caret": "Improve with Cline"
      },
      "file_paths": {
        ".caretrules": ".clinerules",
        "Documents/Caret": "Documents/Cline",
        "\"Caret\"": "\"Cline\"",
        "~/Documents/Caret": "~/Documents/CodeCenter",
        ", \"Caret\",": ", \"Cline\",",
        "~/Documents/Caret/MCP": "~/Documents/Cline/MCP",
        "caret_mcp_settings.json": "cline_mcp_settings.json"
      },
      "terminal": {
        "caretive.caret": "saoudrizwan.claude-dev",
        "Caret": "Cline"
      }
    },
    "package_fields": [
      "displayName",
      "description",
      "version",
      "name",
      "author.name",
      "publisher",
      "repository.url",
      "homepage"
    ]
  }