{
  "metadata": {
    "name": "codecenter-frontend",
    "version": "1.0.0", 
    "description": "CodeCenter 프론트엔드 브랜드 변환 설정",
    "target": "caret",
    "direction": "caret ↔ codecenter",
    "createdDate": "2025-09-03"
  },
  "brand_mappings": {
    "locale_files": {
      "source_brand": "caret",
      "target_brand": "codecenter",
      "brand_replacements": {
        "Caret": "CodeCenter",
        "caret": "codecenter",
        "캐럿": "코드센터",
        "Caret이": "CodeCenter가",
        "Caret을": "CodeCenter를",
        "Caret의": "CodeCenter의",
        "Caret과": "CodeCenter와",
        "Caret에": "CodeCenter에",
        "Caret으로": "CodeCenter로"
      }
    }
  },
  "features": {
    "cost_hiding": {
      "enabled": true,
      "description": "CodeCenter에서 UI 비용 표시 숨김 기능",
      "targets": [
        {
          "type": "css_class",
          "selector": ".task-cost-display",
          "action": "hide",
          "method": "display_none"
        },
        {
          "type": "css_class", 
          "selector": ".api-request-cost",
          "action": "hide",
          "method": "display_none"
        },
        {
          "type": "element_attribute",
          "selector": "[data-cost-display]",
          "action": "hide",
          "method": "visibility_hidden"
        }
      ],
      "recovery": {
        "enabled": true,
        "backup_classes": true,
        "restore_method": "remove_hide_classes"
      }
    }
  },
  "file_paths": {
    "locale_source": "webview-ui/src/caret/locale-backup-step3",
    "locale_target": "webview-ui/src/caret/locale",
    "locale_backup": "caret-b2b/brands/caret/backup/locale",
    "style_files": [
      "webview-ui/src/components/chat/task-header/TaskHeader.tsx",
      "webview-ui/src/components/chat/ChatRow.tsx"
    ]
  },
  "conversion_rules": {
    "pre_conversion": [
      {
        "action": "backup_current_locale",
        "source": "webview-ui/src/caret/locale",
        "destination": "caret-b2b/brands/caret/backup/locale"
      },
      {
        "action": "validate_source_locale",
        "source": "webview-ui/src/caret/locale-backup-step3"
      }
    ],
    "conversion": [
      {
        "action": "copy_locale_files",
        "source": "webview-ui/src/caret/locale-backup-step3",
        "destination": "webview-ui/src/caret/locale"
      },
      {
        "action": "apply_brand_replacements",
        "files": "*.json",
        "replacements": "brand_mappings.locale_files.brand_replacements"
      },
      {
        "action": "apply_cost_hiding",
        "enabled": "features.cost_hiding.enabled",
        "targets": "features.cost_hiding.targets"
      }
    ],
    "post_conversion": [
      {
        "action": "validate_json_files",
        "path": "webview-ui/src/caret/locale"
      },
      {
        "action": "update_conversion_log",
        "timestamp": true,
        "direction": "caret → codecenter"
      }
    ]
  },
  "rollback_rules": {
    "restore_actions": [
      {
        "action": "restore_locale_backup",
        "source": "caret-b2b/brands/caret/backup/locale",
        "destination": "webview-ui/src/caret/locale"
      },
      {
        "action": "remove_cost_hiding",
        "targets": "features.cost_hiding.targets"
      },
      {
        "action": "update_conversion_log", 
        "timestamp": true,
        "direction": "codecenter → caret (rollback)"
      }
    ]
  }
}
