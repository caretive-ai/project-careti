{
	"compilerOptions": {
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"lib": ["es2022", "DOM"],
		"module": "esnext",
		"moduleResolution": "Bundler",
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noUnusedLocals": false,
		"resolveJsonModule": true,
		"rootDir": ".",
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"target": "es2022",
		"useDefineForClassFields": true,
		"useUnknownInCatchVariables": false,
		"baseUrl": ".",
		"types": ["vitest/globals", "should"],
		"paths": {
			"@/*": ["src/*"],
			"@caret/*": ["caret-src/*"],
			"@caret-src/*": ["caret-src/*"], // CARET MODIFICATION: Add caret-src alias
			"@caret/core/controller/*": ["caret-src/core/controller/*"],
			"@caret-shared/*": ["caret-src/shared/*"],
			"@api/*": ["src/api/*"],
			"@core/*": ["src/core/*"],
			"@generated/*": ["src/generated/*"],
			"@hosts/*": ["src/hosts/*"],
			"@integrations/*": ["src/integrations/*"],
			"@packages/*": ["src/packages/*"],
			"@services/*": ["src/services/*"],
			"@shared/*": ["src/shared/*"],
			"@utils/*": ["src/utils/*"]
		}
	},
	"include": ["src/**/*", "caret-src/**/*"],
	"exclude": ["node_modules", ".vscode-test", "webview-ui", "src/test/e2e/**/*"]
}
