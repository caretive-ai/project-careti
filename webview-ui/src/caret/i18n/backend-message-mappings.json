{
	"messagePatterns": {
		"wants_to_edit": {
			"pattern": "^(Cline|Caret)\\s+wants\\s+to\\s+edit",
			"ko": "{brandName}이 파일을 편집하려고 합니다",
			"en": "{brandName} wants to edit"
		},
		"wants_to_create": {
			"pattern": "^(Cline|Caret)\\s+wants\\s+to\\s+create",
			"ko": "{brandName}이 파일을 생성하려고 합니다",
			"en": "{brandName} wants to create"
		},
		"wants_to_read": {
			"pattern": "^(Cline|Caret)\\s+wants\\s+to\\s+read",
			"ko": "{brandName}이 파일을 읽으려고 합니다",
			"en": "{brandName} wants to read"
		},
		"wants_to_execute_command": {
			"pattern": "^(Cline|Caret)\\s+wants\\s+to\\s+execute\\s+a\\s+command",
			"ko": "{brandName}이 명령어를 실행하려고 합니다",
			"en": "{brandName} wants to execute a command"
		},
		"wants_to_use_browser": {
			"pattern": "^(Cline|Caret)\\s+wants\\s+to\\s+use\\s+a\\s+browser",
			"ko": "{brandName}이 브라우저를 사용하려고 합니다",
			"en": "{brandName} wants to use a browser"
		},
		"task_completed": {
			"pattern": "^Task\\s+Completed$",
			"ko": "작업이 완료되었습니다",
			"en": "Task Completed"
		},
		"api_request_pending": {
			"pattern": "^API\\s+Request\\.\\.\\.?$",
			"ko": "API 요청 중...",
			"en": "API Request..."
		}
	},
	"fallbacks": {
		"ko": {
			"wants_to_edit": "파일을 편집하려고 합니다",
			"task_completed": "작업이 완료되었습니다",
			"api_request_pending": "API 요청 중...",
			"wants_to_create": "파일을 생성하려고 합니다",
			"wants_to_read": "파일을 읽으려고 합니다",
			"wants_to_execute_command": "명령어를 실행하려고 합니다",
			"wants_to_use_browser": "브라우저를 사용하려고 합니다"
		},
		"en": {
			"wants_to_edit": "wants to edit",
			"task_completed": "Task Completed",
			"api_request_pending": "API Request...",
			"wants_to_create": "wants to create",
			"wants_to_read": "wants to read",
			"wants_to_execute_command": "wants to execute a command",
			"wants_to_use_browser": "wants to use a browser"
		}
	}
}
