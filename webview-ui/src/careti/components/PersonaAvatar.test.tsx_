import { cleanup, render, screen, waitFor } from "@testing-library/react"
import caretAvatar from "@/caret/assets/template_characters/careti.png?inline"
import caretThinking from "@/caret/assets/template_characters/caret_thinking.png?inline"
import PersonaAvatar from "./PersonaAvatar"

describe("PersonaAvatar", () => {
	afterEach(() => {
		cleanup()
	})

	it("falls back to default template avatar when personaProfile is missing", async () => {
		render(<PersonaAvatar personaProfile={undefined} />)

		await waitFor(() => expect(screen.getByTestId("persona-avatar").getAttribute("src")).toBe(caretAvatar))
	})

	it("maps caret_profile asset URIs to template character images", async () => {
		render(
			<PersonaAvatar
				personaProfile={{
					name: "Careti",
					description: "",
					customInstruction: "",
					avatarUri: "asset://template_characters/caret_profile.png",
					thinkingAvatarUri: "asset://template_characters/caret_thinking.png",
				}}
			/>,
		)

		await waitFor(() => expect(screen.getByTestId("persona-avatar").getAttribute("src")).toBe(caretAvatar))
	})

	it("falls back to default thinking image when missing", async () => {
		render(<PersonaAvatar isThinking personaProfile={undefined} />)

		await waitFor(() => expect(screen.getByTestId("persona-avatar").getAttribute("src")).toBe(caretThinking))
	})
})
